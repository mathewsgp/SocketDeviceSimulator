{
  "Name": "Simple Device Protocol",
  "Version": "1.0",
  "StartPrefix": "*",
  "EndPrefix": "#",
  "CommandParameterSeparator": "=",
  "ParameterSeparator": ",",
  "ParameterValueSeparator": ":",
  "Commands": [
    {
      "Name": "LOGIN",
      "Description": "User login - Format: *LOGIN=user:admin,pass:secret#",
      "Parameters": [
        {
          "Name": "user",
          "Type": "string",
          "PossibleValues": ["admin", "guest"],
          "Required": true,
          "DefaultValueIndex": 0
        },
        {
          "Name": "pass",
          "Type": "string",
          "PossibleValues": ["secret", "password123"],
          "Required": true,
          "DefaultValueIndex": 0
        }
      ],
      "ResponseTemplate": "*LOGIN_OK,user:${user},session:${SessionId}#"
    },
    {
      "Name": "LOGIN_OK",
      "Description": "Login successful response",
      "Parameters": [],
      "ResponseTemplate": "*LOGIN_OK#"
    },
    {
      "Name": "READY",
      "Description": "Device ready - Format: *READY,temp:25.5#",
      "Parameters": [
        {
          "Name": "temp",
          "Type": "float",
          "PossibleValues": [],
          "Required": false
        }
      ],
      "ResponseTemplate": "*READY_ACK#"
    },
    {
      "Name": "GET_STATUS",
      "Description": "Get device status - Format: *GET_STATUS#",
      "Parameters": [],
      "ResponseTemplate": "*STATUS,state:${State},temp:${Temperature},pressure:${Pressure}#"
    },
    {
      "Name": "SET_STATE",
      "Description": "Set device state - Format: *SET_STATE=state:ACTIVE#",
      "Parameters": [
        {
          "Name": "state",
          "Type": "string",
          "PossibleValues": ["IDLE", "ACTIVE", "STANDBY", "ERROR"],
          "Required": true,
          "DefaultValueIndex": 0
        }
      ],
      "ResponseTemplate": "*STATE_SET,state:${state}#"
    },
    {
      "Name": "HEARTBEAT",
      "Description": "Heartbeat ping - Format: *HEARTBEAT,count:1#",
      "Parameters": [
        {
          "Name": "count",
          "Type": "int",
          "PossibleValues": [],
          "Required": false
        }
      ],
      "ResponseTemplate": "*HEARTBEAT_ACK,count:${Counter}#"
    },
    {
      "Name": "ERROR",
      "Description": "Error response - Format: *ERROR,code:E001,msg:Timeout#",
      "Parameters": [
        {
          "Name": "code",
          "Type": "string",
          "PossibleValues": ["E001", "E002", "E003"],
          "Required": true,
          "DefaultValueIndex": 0
        },
        {
          "Name": "msg",
          "Type": "string",
          "PossibleValues": [],
          "Required": true
        }
      ],
      "ResponseTemplate": "*ERROR_ACK,code:${code}#"
    }
  ]
}

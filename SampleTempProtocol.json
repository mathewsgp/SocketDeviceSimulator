{
  "Name": "Temperature Measurement Protocol",
  "Version": "1.0",
  "StartPrefix": "",
  "EndPrefix": "",
  "CommandParameterSeparator": " ",
  "ParameterSeparator": ",",
  "ParameterValueSeparator": "=",
  "Commands": [
    {
      "Name": "GET_STATUS",
      "Description": "Get device status - returns current State and Temperature variables",
      "Parameters": [],
      "ResponseTemplate": "STATUS state=${State} temp=${Temperature}"
    },
    {
      "Name": "SET_PARAMS",
      "Description": "Set measurement parameters (start and end temperature)",
      "Parameters": [
        {
          "Name": "start",
          "Type": "int",
          "Required": true
        },
        {
          "Name": "end",
          "Type": "int",
          "Required": true
        }
      ],
      "ResponseTemplate": "SET_PARAMS_OK start=${start} end=${end}"
    },
    {
      "Name": "START",
      "Description": "Start measurement",
      "Parameters": [],
      "ResponseTemplate": "START_OK"
    },
    {
      "Name": "STATUS",
      "Description": "Status response with state and temperature",
      "Parameters": [],
      "ResponseTemplate": "STATUS state=${State} temp=${Temperature}"
    },
    {
      "Name": "SET_PARAMS_OK",
      "Description": "Set params acknowledgment",
      "Parameters": [],
      "ResponseTemplate": "SET_PARAMS_OK"
    },
    {
      "Name": "START_OK",
      "Description": "Start acknowledgment",
      "Parameters": [],
      "ResponseTemplate": "START_OK"
    }
  ]
}

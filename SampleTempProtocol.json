{
  "Name": "Temperature Measurement Protocol",
  "Version": "1.0",
  "StartPrefix": "*",
  "EndPrefix": "#",
  "CommandParameterSeparator": "=",
  "ParameterSeparator": ",",
  "ParameterValueSeparator": ":",
  "Commands": [
    {
      "Name": "GET_STATUS",
      "Description": "Get device status - Format: *GET_STATUS#",
      "Parameters": [],
      "ResponseTemplate": "*STATUS,state:${State},temp:${Temperature}#"
    },
    {
      "Name": "STOP",
      "Description": "Stop any ongoing measurement - Format: *STOP#",
      "Parameters": [],
      "ResponseTemplate": "*STOP_OK#"
    },
    {
      "Name": "SET_PARAMS",
      "Description": "Set measurement parameters - Format: *SET_PARAMS=start:20,end:100#",
      "Parameters": [
        {
          "Name": "start",
          "Type": "int",
          "Required": true
        },
        {
          "Name": "end",
          "Type": "int",
          "Required": true
        }
      ],
      "ResponseTemplate": "*PARAMS_OK,start:${start},end:${end}#"
    },
    {
      "Name": "START",
      "Description": "Start measurement - Format: *START#",
      "Parameters": [],
      "ResponseTemplate": "*START_OK#"
    },
    {
      "Name": "STATUS",
      "Description": "Status response",
      "Parameters": [],
      "ResponseTemplate": "*STATUS,state:READY,temp:25#"
    },
    {
      "Name": "STOP_OK",
      "Description": "Stop acknowledgment",
      "Parameters": [],
      "ResponseTemplate": "*STOP_OK#"
    },
    {
      "Name": "PARAMS_OK",
      "Description": "Params acknowledgment",
      "Parameters": [],
      "ResponseTemplate": "*PARAMS_OK#"
    },
    {
      "Name": "START_OK",
      "Description": "Start acknowledgment",
      "Parameters": [],
      "ResponseTemplate": "*START_OK#"
    }
  ]
}

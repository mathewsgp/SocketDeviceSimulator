{
  "Name": "Server - Temperature Device",
  "Scenario": {
    "Name": "Temperature Measurement Device",
    "Description": "Simulates a temperature measurement device. Device is READY initially.",
    "Steps": [
      {
        "Type": "AutoReply",
        "Order": 1,
        "Description": "Device is READY - auto-reply to GET_STATUS",
        "CommandPattern": "GET_STATUS",
        "Response": "STATUS state=READY temp=25"
      },
      {
        "Type": "WaitCommand",
        "Order": 2,
        "Description": "Wait for SET_PARAMS command from client",
        "CommandName": "SET_PARAMS",
        "TimeoutMs": 60000
      },
      {
        "Type": "SendResponse",
        "Order": 3,
        "Description": "Send params acknowledgment",
        "CommandName": "SET_PARAMS_OK",
        "Response": "SET_PARAMS_OK"
      },
      {
        "Type": "WaitCommand",
        "Order": 4,
        "Description": "Wait for START command from client",
        "CommandName": "START",
        "TimeoutMs": 60000
      },
      {
        "Type": "SendResponse",
        "Order": 5,
        "Description": "Send start acknowledgment",
        "CommandName": "START_OK",
        "Response": "START_OK"
      },
      {
        "Type": "AutoReply",
        "Order": 6,
        "Description": "Auto-reply: status IN_PROGRESS temp=50",
        "CommandPattern": "GET_STATUS",
        "Response": "STATUS state=IN_PROGRESS temp=50"
      },
      {
        "Type": "Delay",
        "Order": 7,
        "Description": "Simulate measurement time",
        "DurationMs": 2000
      },
      {
        "Type": "AutoReply",
        "Order": 8,
        "Description": "Auto-reply: status IN_PROGRESS temp=75",
        "CommandPattern": "GET_STATUS",
        "Response": "STATUS state=IN_PROGRESS temp=75"
      },
      {
        "Type": "Delay",
        "Order": 9,
        "Description": "Simulate measurement time",
        "DurationMs": 2000
      },
      {
        "Type": "AutoReply",
        "Order": 10,
        "Description": "Auto-reply: status COMPLETED",
        "CommandPattern": "GET_STATUS",
        "Response": "STATUS state=COMPLETED temp=100"
      }
    ]
  },
  "ConnectionSettings": {
    "Mode": 0,
    "IpAddress": "127.0.0.1",
    "Port": 9000
  }
}

{
  "Name": "Client - Measurement Controller",
  "Scenario": {
    "Name": "Temperature Measurement Control",
    "Description": "Client workflow: Check status, set params, start measurement, poll until state=COMPLETED",
    "Steps": [
      {
        "Type": "SendCommand",
        "Order": 1,
        "Description": "Query device status",
        "CommandName": "GET_STATUS",
        "Payload": "GET_STATUS"
      },
      {
        "Type": "WaitResponse",
        "Order": 2,
        "Description": "Wait for status response (expects READY)",
        "CommandName": "STATUS",
        "ExpectedResponseContains": "READY",
        "TimeoutMs": 5000
      },
      {
        "Type": "SendCommand",
        "Order": 3,
        "Description": "Set measurement parameters (start=20, end=100)",
        "CommandName": "SET_PARAMS",
        "Payload": "SET_PARAMS start=20 end=100"
      },
      {
        "Type": "WaitCommand",
        "Order": 4,
        "Description": "Wait for SET_PARAMS_OK",
        "CommandName": "SET_PARAMS_OK",
        "TimeoutMs": 5000
      },
      {
        "Type": "SendCommand",
        "Order": 5,
        "Description": "Start measurement",
        "CommandName": "START",
        "Payload": "START"
      },
      {
        "Type": "WaitCommand",
        "Order": 6,
        "Description": "Wait for START_OK",
        "CommandName": "START_OK",
        "TimeoutMs": 5000
      },
      {
        "Type": "SendCommand",
        "Order": 7,
        "Description": "Poll status - check 1",
        "CommandName": "GET_STATUS",
        "Payload": "GET_STATUS"
      },
      {
        "Type": "WaitResponse",
        "Order": 8,
        "Description": "Wait for status response",
        "CommandName": "STATUS",
        "ExpectedResponseContains": "IN_PROGRESS",
        "TimeoutMs": 5000
      },
      {
        "Type": "SendCommand",
        "Order": 9,
        "Description": "Poll status - check 2",
        "CommandName": "GET_STATUS",
        "Payload": "GET_STATUS"
      },
      {
        "Type": "WaitResponse",
        "Order": 10,
        "Description": "Wait for status response",
        "CommandName": "STATUS",
        "ExpectedResponseContains": "IN_PROGRESS",
        "TimeoutMs": 5000
      },
      {
        "Type": "SendCommand",
        "Order": 11,
        "Description": "Poll status - check 3",
        "CommandName": "GET_STATUS",
        "Payload": "GET_STATUS"
      },
      {
        "Type": "WaitResponse",
        "Order": 12,
        "Description": "Wait for status response",
        "CommandName": "STATUS",
        "ExpectedResponseContains": "IN_PROGRESS",
        "TimeoutMs": 5000
      },
      {
        "Type": "SendCommand",
        "Order": 13,
        "Description": "Poll status - check 4",
        "CommandName": "GET_STATUS",
        "Payload": "GET_STATUS"
      },
      {
        "Type": "WaitResponse",
        "Order": 14,
        "Description": "Wait for status response",
        "CommandName": "STATUS",
        "ExpectedResponseContains": "COMPLETED",
        "TimeoutMs": 10000
      },
      {
        "Type": "Delay",
        "Order": 15,
        "Description": "Measurement complete - delay",
        "DurationMs": 500
      }
    ]
  },
  "ConnectionSettings": {
    "Mode": 1,
    "IpAddress": "127.0.0.1",
    "Port": 9000
  }
}

{
  "Name": "Client - Measurement Controller",
  "Scenario": {
    "Name": "Temperature Measurement Control",
    "Description": "Client workflow: Check status, set params, start measurement, poll until state=COMPLETED",
    "Steps": [
      {
        "Type": "SendCommand",
        "Order": 1,
        "Description": "Query device status",
        "CommandName": "GET_STATUS",
        "Payload": "GET_STATUS"
      },
      {
        "Type": "WaitResponse",
        "Order": 2,
        "Description": "Wait for READY status",
        "CommandName": "STATUS",
        "ExpectedResponseContains": "READY",
        "TimeoutMs": 5000
      },
      {
        "Type": "SendCommand",
        "Order": 3,
        "Description": "Set measurement params",
        "CommandName": "SET_PARAMS",
        "Payload": "SET_PARAMS start=20 end=100"
      },
      {
        "Type": "WaitCommand",
        "Order": 4,
        "Description": "Wait for SET_PARAMS_OK",
        "CommandName": "SET_PARAMS_OK",
        "TimeoutMs": 5000
      },
      {
        "Type": "SendCommand",
        "Order": 5,
        "Description": "Start measurement",
        "CommandName": "START",
        "Payload": "START"
      },
      {
        "Type": "WaitCommand",
        "Order": 6,
        "Description": "Wait for START_OK",
        "CommandName": "START_OK",
        "TimeoutMs": 5000
      },
      {
        "Type": "SetVariable",
        "Order": 7,
        "Description": "Initialize PollCount=0",
        "VariableName": "PollCount",
        "Value": "0",
        "Operation": "Set"
      },
      {
        "Type": "Label",
        "Order": 8,
        "Description": "Poll loop start",
        "LabelName": "PollLoop"
      },
      {
        "Type": "SetVariable",
        "Order": 9,
        "Description": "Increment PollCount",
        "VariableName": "PollCount",
        "Value": "1",
        "Operation": "Increment"
      },
      {
        "Type": "SendCommand",
        "Order": 10,
        "Description": "Poll device status",
        "CommandName": "GET_STATUS",
        "Payload": "GET_STATUS"
      },
      {
        "Type": "WaitResponse",
        "Order": 11,
        "Description": "Wait for status response",
        "CommandName": "STATUS",
        "TimeoutMs": 5000
      },
      {
        "Type": "IfElse",
        "Order": 12,
        "Description": "Check if State=COMPLETED",
        "Condition": "${State} == COMPLETED",
        "GotoLabelIfTrue": "Done"
      },
      {
        "Type": "IfElse",
        "Order": 13,
        "Description": "Check if PollCount<10",
        "Condition": "${PollCount} < 10",
        "GotoLabelIfTrue": "WaitAndRepoll"
      },
      {
        "Type": "Label",
        "Order": 14,
        "Description": "Wait before re-polling",
        "LabelName": "WaitAndRepoll"
      },
      {
        "Type": "Delay",
        "Order": 15,
        "Description": "Wait 2 seconds",
        "DurationMs": 2000
      },
      {
        "Type": "Goto",
        "Order": 16,
        "Description": "Poll again",
        "TargetLabel": "PollLoop"
      },
      {
        "Type": "Label",
        "Order": 17,
        "Description": "Measurement complete",
        "LabelName": "Done"
      },
      {
        "Type": "Delay",
        "Order": 18,
        "Description": "Final delay",
        "DurationMs": 500
      }
    ]
  },
  "ConnectionSettings": {
    "Mode": 1,
    "IpAddress": "127.0.0.1",
    "Port": 9000
  }
}

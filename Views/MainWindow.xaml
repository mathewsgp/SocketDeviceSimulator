<Window x:Class="SocketSimulator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SocketSimulator.Views"
        xmlns:vm="clr-namespace:SocketSimulator.ViewModels"
        xmlns:conv="clr-namespace:SocketSimulator.Converters"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="800" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:LogLevelToBrushConverter x:Key="LogLevelToBrush"/>
        <conv:ConnectionModeToStringConverter x:Key="ConnectionModeToString"/>
        <conv:ConsoleEntryTypeToBrushConverter x:Key="ConsoleEntryTypeToBrush"/>
        <conv:StepTypeToStringConverter x:Key="StepTypeToString"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}">
            <MenuItem Header="_File">
                <MenuItem Header="_New Project" Command="{Binding NewProjectCommand}" InputGestureText="Ctrl+N"/>
                <MenuItem Header="_Open Project..." Command="{Binding OpenProjectCommand}" InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="_Save Project" Command="{Binding SaveProjectCommand}" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Save Project _As..." Command="{Binding SaveProjectAsCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_Protocol">
                <MenuItem Header="_Load Protocol..." Command="{Binding ProtocolVM.LoadProtocolCommand}"/>
                <MenuItem Header="_Save Protocol..." Command="{Binding ProtocolVM.SaveProtocolCommand}"/>
                <Separator/>
                <MenuItem Header="_New Protocol" Command="{Binding ProtocolVM.NewProtocolCommand}"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConnectionVM.IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ConnectionVM.ConnectionStatus}"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding ProtocolVM.ProtocolName}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Main Content -->
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Connection Panel -->
                <Border Grid.Row="0" Style="{StaticResource PanelBorder}">
                    <StackPanel>
                        <TextBlock Text="Connection" Style="{StaticResource PanelHeader}"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Mode:" VerticalAlignment="Center" Margin="0,4"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                <RadioButton Content="Server" 
                                           IsChecked="{Binding ConnectionVM.Mode, Converter={StaticResource ConnectionModeToString}, ConverterParameter=Server}"
                                           Margin="0,0,8,0"/>
                                <RadioButton Content="Client"
                                           IsChecked="{Binding ConnectionVM.Mode, Converter={StaticResource ConnectionModeToString}, ConverterParameter=Client}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="IP Address:" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox Grid.Row="1" Grid.Column="1" 
                                    Text="{Binding ConnectionVM.IpAddress, UpdateSourceTrigger=PropertyChanged}"
                                    Width="120" Style="{StaticResource ModernTextBox}" Margin="0,4"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Port:" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox Grid.Row="2" Grid.Column="1" 
                                    Text="{Binding ConnectionVM.Port, UpdateSourceTrigger=PropertyChanged}"
                                    Width="120" Style="{StaticResource ModernTextBox}" Margin="0,4"/>

                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" 
                                       Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <Button Content="Connect" Command="{Binding ConnectionVM.ConnectCommand}"
                                       Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                       Visibility="{Binding ConnectionVM.IsConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
                                <Button Content="Disconnect" Command="{Binding ConnectionVM.DisconnectCommand}"
                                       Style="{StaticResource SecondaryButton}"
                                       Visibility="{Binding ConnectionVM.IsConnected, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Protocol Explorer -->
                <Border Grid.Row="1" Style="{StaticResource PanelBorder}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Protocol Explorer" Style="{StaticResource PanelHeader}"/>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Load" Command="{Binding ProtocolVM.LoadProtocolCommand}" 
                                   Style="{StaticResource SecondaryButton}" Margin="0,0,4,0" Padding="8,4"/>
                            <Button Content="New" Command="{Binding ProtocolVM.NewProtocolCommand}" 
                                   Style="{StaticResource SecondaryButton}" Padding="8,4"/>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding ProtocolVM.Commands}" 
                                SelectedItem="{Binding ProtocolVM.SelectedCommand}"
                                Style="{StaticResource ModernListBox}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Variables Panel -->
                <Border Grid.Row="2" Style="{StaticResource PanelBorder}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Variables" Style="{StaticResource PanelHeader}"/>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Add" Command="{Binding VariableVM.AddVariableCommand}" 
                                   Style="{StaticResource SecondaryButton}" Margin="0,0,4,0" Padding="8,4"/>
                            <Button Content="Reset" Command="{Binding VariableVM.ResetVariablesCommand}" 
                                   Style="{StaticResource SecondaryButton}" Padding="8,4"/>
                        </StackPanel>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBox Text="{Binding VariableVM.NewVariableName, UpdateSourceTrigger=PropertyChanged}"
                                        Width="100" Style="{StaticResource ModernTextBox}" Margin="0,0,4,0"/>
                                <TextBox Text="{Binding VariableVM.NewVariableValue, UpdateSourceTrigger=PropertyChanged}"
                                        Width="100" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding VariableVM.Variables}"
                                     SelectedItem="{Binding VariableVM.SelectedVariable}"
                                     AutoGenerateColumns="False" IsReadOnly="True"
                                     HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Center Panel -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Scenario Editor -->
                <Border Grid.Row="0" Style="{StaticResource PanelBorder}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Scenario Editor" Style="{StaticResource PanelHeader}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Run" Command="{Binding ScenarioVM.RunScenarioCommand}"
                                       Style="{StaticResource PrimaryButton}" Margin="0,0,4,0" Padding="12,4"
                                       Visibility="{Binding ScenarioVM.IsRunning, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
                                <Button Content="Stop" Command="{Binding ScenarioVM.StopScenarioCommand}"
                                       Style="{StaticResource SecondaryButton}" Padding="12,4"
                                       Visibility="{Binding ScenarioVM.IsRunning, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Step Toolbar -->
                        <ToolBarTray DockPanel.Dock="Top" Margin="0,8">
                            <ToolBar Band="0" BandIndex="0">
                                <Button Content="Wait Command" Command="{Binding ScenarioVM.AddStepCommand}" CommandParameter="WaitCommand" ToolTip="Wait for a command"/>
                                <Button Content="Send Response" Command="{Binding ScenarioVM.AddStepCommand}" CommandParameter="SendResponse" ToolTip="Send a response"/>
                                <Button Content="Send Command" Command="{Binding ScenarioVM.AddStepCommand}" CommandParameter="SendCommand" ToolTip="Send a command"/>
                                <Separator/>
                                <Button Content="Delay" Command="{Binding ScenarioVM.AddStepCommand}" CommandParameter="Delay" ToolTip="Wait for specified time"/>
                                <Button Content="Set Variable" Command="{Binding ScenarioVM.AddStepCommand}" CommandParameter="SetVariable" ToolTip="Set a variable value"/>
                                <Button Content="If/Else" Command="{Binding ScenarioVM.AddStepCommand}" CommandParameter="IfElse" ToolTip="Conditional execution"/>
                                <Button Content="Loop Until" Command="{Binding ScenarioVM.AddStepCommand}" CommandParameter="LoopUntil" ToolTip="Loop until condition is met"/>
                                <Separator/>
                                <Button Content="Remove" Command="{Binding ScenarioVM.RemoveStepCommand}" ToolTip="Remove selected step"/>
                                <Button Content="↑" Command="{Binding ScenarioVM.MoveUpCommand}" Width="30" ToolTip="Move up"/>
                                <Button Content="↓" Command="{Binding ScenarioVM.MoveDownCommand}" Width="30" ToolTip="Move down"/>
                            </ToolBar>
                        </ToolBarTray>

                        <ListBox ItemsSource="{Binding ScenarioVM.Steps}"
                                SelectedItem="{Binding ScenarioVM.SelectedStep}"
                                Style="{StaticResource ModernListBox}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Order}" 
                                                  Foreground="{StaticResource TextSecondaryBrush}"
                                                  VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Converter={StaticResource StepTypeToString}}" 
                                                      FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" 
                                                      Foreground="{StaticResource TextSecondaryBrush}"
                                                      FontSize="11"
                                                      TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Communication Log -->
                <Border Grid.Row="1" Style="{StaticResource PanelBorder}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Communication Log" Style="{StaticResource PanelHeader}"/>
                            <Button Grid.Column="1" Content="Clear" Command="{Binding LogVM.ClearCommand}" 
                                   Style="{StaticResource SecondaryButton}" Padding="8,4"/>
                        </Grid>
                        <ListBox ItemsSource="{Binding LogVM.LogEntries}" 
                                Style="{StaticResource ModernListBox}"
                                x:Name="LogListBox">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" 
                                              Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}"
                                              FontFamily="Consolas" FontSize="11"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Right Panel -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Console -->
                <Border Grid.Row="0" Style="{StaticResource PanelBorder}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Manual Console" Style="{StaticResource PanelHeader}"/>
                        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" 
                                    Text="{Binding ConsoleVM.CommandText, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource ModernTextBox}"
                                    x:Name="ConsoleInput"/>
                            <Button Grid.Column="1" Content="Send" Command="{Binding ConsoleVM.SendCommandCommand}"
                                   Style="{StaticResource PrimaryButton}" Margin="4,0,0,0" Padding="8,4"/>
                            <Button Grid.Column="2" Content="Clear" Command="{Binding ConsoleVM.ClearHistoryCommand}"
                                   Style="{StaticResource SecondaryButton}" Margin="4,0,0,0" Padding="8,4"/>
                        </Grid>
                        <ListBox ItemsSource="{Binding ConsoleVM.History}" 
                                Style="{StaticResource ModernListBox}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding TypePrefix}" 
                                                  Foreground="{Binding Type, Converter={StaticResource ConsoleEntryTypeToBrush}}"
                                                  FontFamily="Consolas" FontWeight="Bold" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Message}" FontFamily="Consolas"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Step Details -->
                <Border Grid.Row="1" Style="{StaticResource PanelBorder}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Step Details" Style="{StaticResource PanelHeader}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- No step selected message -->
                                <TextBlock Text="Select a step to edit" 
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          Visibility="{Binding ScenarioVM.SelectedStep, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
                                
                                <!-- Common Properties (shown when step is selected) -->
                                <StackPanel Visibility="{Binding ScenarioVM.SelectedStep, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Step Type:" Margin="0,4,0,2"/>
                                    <TextBlock Text="{Binding ScenarioVM.SelectedStep, Converter={StaticResource StepTypeToString}}"
                                              FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                    
                                    <TextBlock Text="Description:" Margin="0,12,0,2"/>
                                    <TextBox Text="{Binding ScenarioVM.SelectedStep.Description, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>

                                <!-- WaitCommand -->
                                <StackPanel Visibility="{Binding ScenarioVM.SelectedStep, Converter={StaticResource StepTypeToString}, ConverterParameter=WaitCommand}">
                                    <TextBlock Text="Command Name:" Margin="0,12,0,2"/>
                                    <TextBox Text="{Binding ScenarioVM.SelectedWaitCommandStep.CommandName, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource ModernTextBox}"/>
                                    <TextBlock Text="Expected command to receive" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,2,0,0"/>
                                    
                                    <TextBlock Text="Timeout (ms):" Margin="0,12,0,2"/>
                                    <TextBox Text="{Binding ScenarioVM.SelectedWaitCommandStep.TimeoutMs, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>

                                <!-- SendResponse -->
                                <StackPanel Visibility="{Binding ScenarioVM.SelectedStep, Converter={StaticResource StepTypeToString}, ConverterParameter=SendResponse}">
                                    <!-- Protocol Command Selection -->
                                    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,8,0,8">
                                        <StackPanel>
                                            <TextBlock Text="From Protocol:" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0"
                                                         ItemsSource="{Binding ScenarioVM.ProtocolCommandNames}"
                                                         SelectedItem="{Binding ScenarioVM.SelectedProtocolCommandName}"
                                                         Style="{StaticResource ModernComboBox}"/>
                                                <Button Grid.Column="1" Content="Apply" 
                                                       Command="{Binding ScenarioVM.ApplyProtocolTemplateCommand}"
                                                       Style="{StaticResource PrimaryButton}" 
                                                       Margin="8,0,0,0" Padding="12,4"/>
                                            </Grid>
                                            <TextBlock Text="Select a command from loaded Protocol to auto-fill" 
                                                      Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <TextBlock Text="Command Name:" Margin="0,8,0,2"/>
                                    <TextBox Text="{Binding ScenarioVM.SelectedSendResponseStep.CommandName, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource ModernTextBox}"/>
                                    
                                    <TextBlock Text="Response:" Margin="0,12,0,2"/>
                                    <TextBox Text="{Binding ScenarioVM.SelectedSendResponseStep.Response, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource ModernTextBox}" AcceptsReturn="True" Height="60" TextWrapping="Wrap"/>
                                    <TextBlock Text="Variables: ${VariableName}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- SendCommand -->
                                <StackPanel Visibility="{Binding ScenarioVM.SelectedStep, Converter={StaticResource StepTypeToString}, ConverterParameter=SendCommand}">
                                    <!-- Protocol Command Selection -->
                                    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,8,0,8">
                                        <StackPanel>
                                            <TextBlock Text="From Protocol:" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0"
                                                         ItemsSource="{Binding ScenarioVM.ProtocolCommandNames}"
                                                         SelectedItem="{Binding ScenarioVM.SelectedProtocolCommandName}"
                                                         Style="{StaticResource ModernComboBox}"/>
                                                <Button Grid.Column="1" Content="Apply" 
                                                       Command="{Binding ScenarioVM.ApplyProtocolTemplateCommand}"
                                                       Style="{StaticResource PrimaryButton}" 
                                                       Margin="8,0,0,0" Padding="12,4"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    
                                    <TextBlock Text="Command Name:" Margin="0,8,0,2"/>
                                    <TextBox Text="{Binding ScenarioVM.SelectedSendCommandStep.CommandName, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource ModernTextBox}"/>
                                    
                                    <TextBlock Text="Payload:" Margin="0,12,0,2"/>
                                    <TextBox Text="{Binding ScenarioVM.SelectedSendCommandStep.Payload, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource ModernTextBox}" AcceptsReturn="True" Height="60" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Delay -->
                                <StackPanel Visibility="{Binding ScenarioVM.SelectedStep, Converter={StaticResource StepTypeToString}, ConverterParameter=Delay}">
                                    <TextBlock Text="Duration (ms):" Margin="0,12,0,2"/>
                                    <TextBox Text="{Binding ScenarioVM.SelectedDelayStep.DurationMs, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource ModernTextBox}"/>
                                    <TextBlock Text="1000ms = 1 second" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- SetVariable -->
                                <StackPanel Visibility="{Binding ScenarioVM.SelectedStep, Converter={StaticResource StepTypeToString}, ConverterParameter=SetVariable}">
                                    <TextBlock Text="Variable Name:" Margin="0,12,0,2"/>
                                    <TextBox Text="{Binding ScenarioVM.SelectedSetVariableStep.VariableName, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource ModernTextBox}"/>
                                    
                                    <TextBlock Text="Operation:" Margin="0,12,0,2"/>
                                    <ComboBox SelectedValue="{Binding ScenarioVM.SelectedSetVariableStep.Operation, UpdateSourceTrigger=PropertyChanged}"
                                             SelectedValuePath="Tag">
                                        <ComboBoxItem Content="Set" Tag="Set"/>
                                        <ComboBoxItem Content="Increment" Tag="Increment"/>
                                        <ComboBoxItem Content="Decrement" Tag="Decrement"/>
                                        <ComboBoxItem Content="Toggle" Tag="Toggle"/>
                                    </ComboBox>
                                    
                                    <TextBlock Text="Value:" Margin="0,12,0,2"/>
                                    <TextBox Text="{Binding ScenarioVM.SelectedSetVariableStep.Value, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>

                                <!-- IfElse -->
                                <StackPanel Visibility="{Binding ScenarioVM.SelectedStep, Converter={StaticResource StepTypeToString}, ConverterParameter=IfElse}">
                                    <TextBlock Text="Condition:" Margin="0,12,0,2"/>
                                    <TextBox Text="{Binding ScenarioVM.SelectedIfElseStep.Condition, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource ModernTextBox}" AcceptsReturn="True" Height="40"/>
                                    <TextBlock Text="Example: ${State} == ACTIVE or ${Count} &gt; 10" 
                                              Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- LoopUntil -->
                                <StackPanel Visibility="{Binding ScenarioVM.SelectedStep, Converter={StaticResource StepTypeToString}, ConverterParameter=LoopUntil}">
                                    <!-- Protocol Command Selection -->
                                    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,8,0,8">
                                        <StackPanel>
                                            <TextBlock Text="From Protocol:" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0"
                                                         ItemsSource="{Binding ScenarioVM.ProtocolCommandNames}"
                                                         SelectedItem="{Binding ScenarioVM.SelectedProtocolCommandName}"
                                                         Style="{StaticResource ModernComboBox}"/>
                                                <Button Grid.Column="1" Content="Apply" 
                                                       Command="{Binding ScenarioVM.ApplyProtocolTemplateCommand}"
                                                       Style="{StaticResource PrimaryButton}" 
                                                       Margin="8,0,0,0" Padding="12,4"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    
                                    <TextBlock Text="Command to Send:" Margin="0,8,0,2"/>
                                    <TextBox Text="{Binding ScenarioVM.SelectedLoopUntilStep.CommandToSend, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource ModernTextBox}"/>
                                    
                                    <TextBlock Text="Payload:" Margin="0,12,0,2"/>
                                    <TextBox Text="{Binding ScenarioVM.SelectedLoopUntilStep.Payload, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource ModernTextBox}" AcceptsReturn="True" Height="40" TextWrapping="Wrap"/>
                                    
                                    <TextBlock Text="Expected Response Contains:" Margin="0,12,0,2"/>
                                    <TextBox Text="{Binding ScenarioVM.SelectedLoopUntilStep.ExpectedResponseContains, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource ModernTextBox}"/>
                                    <TextBlock Text="Loop continues until response contains this text" 
                                              Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,2,0,0"/>
                                    
                                    <TextBlock Text="Interval (ms):" Margin="0,12,0,2"/>
                                    <TextBox Text="{Binding ScenarioVM.SelectedLoopUntilStep.IntervalMs, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource ModernTextBox}"/>
                                    <TextBlock Text="Wait time between each poll" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,2,0,0"/>
                                    
                                    <TextBlock Text="Max Iterations:" Margin="0,12,0,2"/>
                                    <TextBox Text="{Binding ScenarioVM.SelectedLoopUntilStep.MaxIterations, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource ModernTextBox}"/>
                                    <TextBlock Text="Maximum number of polls before timeout" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,2,0,0"/>
                                    
                                    <!-- Pre-Actions Section -->
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,16,0,8" Padding="8" CornerRadius="4">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="+ Add" 
                                                   Command="{Binding ScenarioVM.AddPreActionCommand}" 
                                                   CommandParameter="PreAction"
                                                   Style="{StaticResource SecondaryButton}" Padding="8,2"/>
                                            <TextBlock Text="Pre-Actions (run before each poll):" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                    
                                    <!-- On-Success Actions Section -->
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,8" Padding="8" CornerRadius="4">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="+ Add" 
                                                   Command="{Binding ScenarioVM.AddOnSuccessCommand}" 
                                                   CommandParameter="OnSuccess"
                                                   Style="{StaticResource SecondaryButton}" Padding="8,2"/>
                                            <TextBlock Text="On-Success Actions:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                    
                                    <!-- On-Timeout Actions Section -->
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,8" Padding="8" CornerRadius="4">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="+ Add" 
                                                   Command="{Binding ScenarioVM.AddOnTimeoutCommand}" 
                                                   CommandParameter="OnTimeout"
                                                   Style="{StaticResource SecondaryButton}" Padding="8,2"/>
                                            <TextBlock Text="On-Timeout Actions:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

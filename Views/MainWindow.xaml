<Window x:Class="SocketSimulator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SocketSimulator.Views"
        xmlns:vm="clr-namespace:SocketSimulator.ViewModels"
        xmlns:conv="clr-namespace:SocketSimulator.Converters"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="800" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:LogLevelToBrushConverter x:Key="LogLevelToBrush"/>
        <conv:ConnectionModeToStringConverter x:Key="ConnectionModeToString"/>
        <conv:ConsoleEntryTypeToBrushConverter x:Key="ConsoleEntryTypeToBrush"/>
        <conv:StepTypeToStringConverter x:Key="StepTypeToString"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}">
            <MenuItem Header="_File">
                <MenuItem Header="_New Project" Command="{Binding NewProjectCommand}" InputGestureText="Ctrl+N"/>
                <MenuItem Header="_Open Project..." Command="{Binding OpenProjectCommand}" InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="_Save Project" Command="{Binding SaveProjectCommand}" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Save Project _As..." Command="{Binding SaveProjectAsCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_Protocol">
                <MenuItem Header="_Load Protocol..." Command="{Binding ProtocolVM.LoadProtocolCommand}"/>
                <MenuItem Header="_Save Protocol..." Command="{Binding ProtocolVM.SaveProtocolCommand}"/>
                <Separator/>
                <MenuItem Header="_New Protocol" Command="{Binding ProtocolVM.NewProtocolCommand}"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConnectionVM.IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ConnectionVM.ConnectionStatus}"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding ProtocolVM.ProtocolName}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Main Content -->
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Connection Panel -->
                <Border Grid.Row="0" Style="{StaticResource PanelBorder}">
                    <StackPanel>
                        <TextBlock Text="Connection" Style="{StaticResource PanelHeader}"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Mode:" VerticalAlignment="Center" Margin="0,4"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                <RadioButton Content="Server" 
                                           IsChecked="{Binding ConnectionVM.Mode, Converter={StaticResource ConnectionModeToString}, ConverterParameter=Server}"
                                           Margin="0,0,8,0"/>
                                <RadioButton Content="Client"
                                           IsChecked="{Binding ConnectionVM.Mode, Converter={StaticResource ConnectionModeToString}, ConverterParameter=Client}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="IP Address:" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox Grid.Row="1" Grid.Column="1" 
                                    Text="{Binding ConnectionVM.IpAddress, UpdateSourceTrigger=PropertyChanged}"
                                    Width="120" Style="{StaticResource ModernTextBox}" Margin="0,4"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Port:" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox Grid.Row="2" Grid.Column="1" 
                                    Text="{Binding ConnectionVM.Port, UpdateSourceTrigger=PropertyChanged}"
                                    Width="120" Style="{StaticResource ModernTextBox}" Margin="0,4"/>

                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" 
                                       Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <Button Content="Connect" Command="{Binding ConnectionVM.ConnectCommand}"
                                       Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                       Visibility="{Binding ConnectionVM.IsConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
                                <Button Content="Disconnect" Command="{Binding ConnectionVM.DisconnectCommand}"
                                       Style="{StaticResource SecondaryButton}"
                                       Visibility="{Binding ConnectionVM.IsConnected, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Protocol Explorer -->
                <Border Grid.Row="1" Style="{StaticResource PanelBorder}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Protocol Explorer" Style="{StaticResource PanelHeader}"/>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Load" Command="{Binding ProtocolVM.LoadProtocolCommand}" 
                                   Style="{StaticResource SecondaryButton}" Margin="0,0,4,0" Padding="8,4"/>
                            <Button Content="New" Command="{Binding ProtocolVM.NewProtocolCommand}" 
                                   Style="{StaticResource SecondaryButton}" Padding="8,4"/>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding ProtocolVM.Commands}" 
                                SelectedItem="{Binding ProtocolVM.SelectedCommand}"
                                Style="{StaticResource ModernListBox}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Variables Panel -->
                <Border Grid.Row="2" Style="{StaticResource PanelBorder}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Variables & Parsed" Style="{StaticResource PanelHeader}"/>
                        
                        <!-- Add Variable Row -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox Text="{Binding VariableVM.NewVariableName, UpdateSourceTrigger=PropertyChanged}"
                                    Width="80" Style="{StaticResource ModernTextBox}" Margin="0,0,4,0"
                                    ToolTip="Variable name"/>
                            <TextBox Text="{Binding VariableVM.NewVariableValue, UpdateSourceTrigger=PropertyChanged}"
                                    Width="80" Style="{StaticResource ModernTextBox}" Margin="0,0,4,0"
                                    ToolTip="Variable value"/>
                            <Button Content="Add" Command="{Binding VariableVM.AddVariableCommand}" 
                                   Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,4,0"/>
                            <Button Content="Reset" Command="{Binding VariableVM.ResetVariablesCommand}" 
                                   Style="{StaticResource SecondaryButton}" Padding="8,4"/>
                        </StackPanel>
                        
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Variables Section -->
                            <TextBlock Grid.Row="0" Text="User Variables" FontWeight="SemiBold" FontSize="11" 
                                      Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,4"/>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding VariableVM.Variables}"
                                     SelectedItem="{Binding VariableVM.SelectedVariable}"
                                     AutoGenerateColumns="False" IsReadOnly="True"
                                     HeadersVisibility="Column" Background="White"
                                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            
                            <!-- Parsed Items Section -->
                            <DockPanel Grid.Row="2" Margin="0,8,0,4">
                                <Button DockPanel.Dock="Right" Content="Clear" 
                                       Command="{Binding VariableVM.ClearParsedCommand}"
                                       Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="10"/>
                                <TextBlock Text="Parsed from Commands" FontWeight="SemiBold" FontSize="11" 
                                          Foreground="{StaticResource InfoBrush}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DataGrid Grid.Row="3" ItemsSource="{Binding VariableVM.ParsedItems}"
                                     AutoGenerateColumns="False" IsReadOnly="True"
                                     HeadersVisibility="Column" Background="#F0F9FF"
                                     BorderBrush="{StaticResource InfoBrush}" BorderThickness="1">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Center Panel -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header with Run/Stop -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Scenario Editor" Style="{StaticResource PanelHeader}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Run" Command="{Binding ScenarioVM.RunScenarioCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="16,8" Visibility="{Binding ScenarioVM.IsRunning, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
                        <Button Content="Stop" Command="{Binding ScenarioVM.StopScenarioCommand}" Style="{StaticResource SecondaryButton}" Padding="16,8" Visibility="{Binding ScenarioVM.IsRunning, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Grid>

                <!-- Step Toolbar -->
                <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,40,0,8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Add Steps" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                                <TextBlock Text="Wait:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Medium"/>
                                <Button Content="Command" Command="{Binding ScenarioVM.AddStepCommand}" CommandParameter="WaitCommand" Style="{StaticResource WaitButton}"/>
                                <Button Content="Response" Command="{Binding ScenarioVM.AddStepCommand}" CommandParameter="WaitResponse" Style="{StaticResource WaitButton}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                                <TextBlock Text="Send:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Medium"/>
                                <Button Content="Response" Command="{Binding ScenarioVM.AddStepCommand}" CommandParameter="SendResponse" Style="{StaticResource SendButton}"/>
                                <Button Content="Command" Command="{Binding ScenarioVM.AddStepCommand}" CommandParameter="SendCommand" Style="{StaticResource SendButton}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                                <TextBlock Text="Control:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Medium"/>
                                <Button Content="Delay" Command="{Binding ScenarioVM.AddStepCommand}" CommandParameter="Delay" Style="{StaticResource ControlButton}"/>
                                <Button Content="Variable" Command="{Binding ScenarioVM.AddStepCommand}" CommandParameter="SetVariable" Style="{StaticResource ControlButton}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                                <TextBlock Text="Flow:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Medium"/>
                                <Button Content="If/Else" Command="{Binding ScenarioVM.AddStepCommand}" CommandParameter="IfElse" Style="{StaticResource FlowButton}"/>
                                <Button Content="Label" Command="{Binding ScenarioVM.AddStepCommand}" CommandParameter="Label" Style="{StaticResource FlowButton}"/>
                                <Button Content="Goto" Command="{Binding ScenarioVM.AddStepCommand}" CommandParameter="Goto" Style="{StaticResource FlowButton}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                                <TextBlock Text="Auto:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Medium"/>
                                <Button Content="Reply" Command="{Binding ScenarioVM.AddStepCommand}" CommandParameter="AutoReply" Style="{StaticResource AutoReplyButton}"/>
                            </StackPanel>
                        </WrapPanel>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,8"/>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Remove" Command="{Binding ScenarioVM.RemoveStepCommand}" Style="{StaticResource ActionButton}" Padding="10,6"/>
                                <Button Content="↑" Command="{Binding ScenarioVM.MoveUpCommand}" Style="{StaticResource ActionButton}" Width="32" Margin="4,0,0,0"/>
                                <Button Content="↓" Command="{Binding ScenarioVM.MoveDownCommand}" Style="{StaticResource ActionButton}" Width="32" Margin="4,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Select a step to edit" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" FontStyle="Italic"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Main Content: Step List + Step Details side by side -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Step List + Manual Send -->
                    <Grid Grid.Column="0" Margin="0,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Step List -->
                        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <ListBox ItemsSource="{Binding ScenarioVM.Steps}" SelectedItem="{Binding ScenarioVM.SelectedStep}" Background="Transparent" BorderThickness="0" Padding="6">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FAFAFA" CornerRadius="6" Padding="10,8" Margin="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{StaticResource PrimaryBrush}" CornerRadius="4" Width="22" Height="22">
                                                    <TextBlock Text="{Binding Order}" Foreground="White" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Grid.Column="1" Width="4" CornerRadius="2" Margin="0,0,10,0" Background="{StaticResource PrimaryBrush}"/>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Converter={StaticResource StepTypeToString}}" FontWeight="SemiBold" FontSize="12"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>

                        <!-- Manual Send -->
                        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,8,0,0" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Manual Send" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding ConsoleVM.Suggestions}" Text="{Binding ConsoleVM.CommandText, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Style="{StaticResource ModernComboBox}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                        <Button Content="Send" Command="{Binding ConsoleVM.SendCommandCommand}" Style="{StaticResource PrimaryButton}" Padding="12,6"/>
                                        <Button Content="Clear" Command="{Binding ConsoleVM.ClearHistoryCommand}" Style="{StaticResource SecondaryButton}" Padding="8,6" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Right: Step Details -->
                    <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Step Details" Style="{StaticResource PanelHeader}"/>
                            <Border Visibility="{Binding ScenarioVM.SelectedStep, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" Background="#F5F5F5" CornerRadius="8" Padding="20">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="📋" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="Select a step to edit" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ScrollViewer Visibility="{Binding ScenarioVM.SelectedStep, Converter={StaticResource BoolToVisibility}}" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border Background="{StaticResource PrimaryBrush}" CornerRadius="6" Padding="10,6" HorizontalAlignment="Left" Margin="0,0,0,12">
                                        <TextBlock Text="{Binding ScenarioVM.SelectedStep, Converter={StaticResource StepTypeToString}}" FontWeight="Bold" Foreground="White" FontSize="12"/>
                                    </Border>
                                    <TextBlock Text="Description:" Margin="0,8,0,4"/>
                                    <TextBox Text="{Binding ScenarioVM.SelectedStep.Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
            <!-- Right Panel - Communication Log -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="8" Padding="16">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Communication Log" Style="{StaticResource PanelHeader}"/>
                        <Button Grid.Column="1" Content="Clear" Command="{Binding LogVM.ClearCommand}" Style="{StaticResource SecondaryButton}" Padding="8,4"/>
                    </Grid>
                    <ListBox ItemsSource="{Binding LogVM.LogEntries}" Style="{StaticResource ModernListBox}" Background="#FAFAFA">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}" FontFamily="Consolas" FontSize="11"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
